{
  "name": "scripts-gallery",
  "compatibility_date": "2026-10-30",
  // A static site: each language is a directory of HTML.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "scripts.mkpo.li", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
